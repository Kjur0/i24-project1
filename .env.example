# Use either a complete MongoDB URI or the three MONGO_* values below.
MONGO_URI=
MONGO_URL=
MONGO_USER=
MONGO_PASS=

# Generate a private value with: openssl rand -base64 32
OTP_SALT=replace-with-a-private-random-value

# These values match the portable HTTPS localhost command in README.md.
APP_DOMAIN=localhost
APP_ORIGIN=https://localhost:3000
