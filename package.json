{
  "name": "i24-project1",
  "version": "0.0.1",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "next dev --experimental-https --hostname localhost",
    "build": "next build",
    "start": "next start",
    "lint:code": "eslint \"**/*.{js,jsx,ts,tsx,mjs,cjs}\"",
    "lint": "pnpm lint:code && pnpm lint:docs",
    "lint:fix": "eslint --fix \"**/*.{js,jsx,ts,tsx,mjs,cjs}\" \"**/*.md\"",
    "lint:docs": "eslint \"**/*.md\"",
    "lint:markdown": "eslint \"**/*.md\"",
    "format": "prettier --write \"**/*.{js,jsx,ts,tsx,mjs,cjs,md,yml,yaml,json}\"",
    "format:check": "prettier --check \"**/*.{js,jsx,ts,tsx,mjs,cjs,md,yml,yaml,json}\"",
    "typecheck": "tsc --noEmit",
    "prepare": "husky"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@hookform/resolvers": "^7.0.7",
    "@simplewebauthn/browser": "^14.0.0",
    "@simplewebauthn/server": "^14.1.0",
    "@tanstack/react-table": "^9.3.1",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.2",
    "input-otp": "^1.5.0",
    "lucide-react": "^1.75.0",
    "mongodb": "^7.9.0",
    "next": "16.4.6",
    "next-themes": "^0.4.6",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-hook-form": "^7.92.0",
    "shadcn": "^4.23.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/markdown": "^9.0.0",
    "@ianvs/prettier-plugin-sort-imports": "^4.7.1",
    "@shadcn/lint": "^0.2.5",
    "@tailwindcss/postcss": "^4.3.5",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@typescript-eslint/parser": "^8.73.0",
    "eslint": "^10.15.0",
    "eslint-config-next": "16.4.6",
    "eslint-config-prettier": "^10.1.8",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.1",
    "prettier": "^3.10.1",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4.3.5",
    "typescript": "^5.9.3"
  },
  "lint-staged": {
    "**/*.{js,jsx,ts,tsx,mjs,cjs}": [
      "eslint --fix",
      "prettier --write --ignore-unknown"
    ],
    "**/*.md": [
      "eslint --fix",
      "prettier --write --ignore-unknown"
    ],
    "**/!(*.js|*.jsx|*.ts|*.tsx|*.mjs|*.cjs|*.md)": "prettier --write --ignore-unknown"
  },
  "packageManager": "pnpm@12.21.0",
  "engines": {
    "runtime": {
      "name": "node",
      "version": "^26.11.1",
      "onFail": "download"
    }
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "^26.11.1",
      "onFail": "download"
    },
    "packageManager": {
      "name": "pnpm",
      "version": "12.21.0",
      "onFail": "download"
    }
  }
}
